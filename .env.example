# Copie para .env e preencha os valores.
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash-lite
# Origens liberadas fora do DEBUG (em DEBUG qualquer origem é aceita).
CORS_ALLOWED_ORIGINS=

# Diagnósticos locais de análise (habilitação explícita; padrão segue DEBUG).
# Contêm texto do contrato e respostas da IA em .diagnostics/ (fora do Git).
AI_DIAGNOSTICS_ENABLED=True
